# ── Server ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── MongoDB ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/jobsync

# ── JWT ────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars

# ── Google OAuth ───────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ── LinkedIn OAuth ─────────────────────────────────────────────────────
# Create at: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:4000/auth/linkedin/callback

# ── Frontend ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# ── OpenAI (optional — leave blank for rule-based fallback) ────────────────────
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=